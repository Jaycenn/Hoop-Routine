PORT=3001
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/hooproutine
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
DATABASE_SSL=false
NODE_ENV=development
TRUST_PROXY_HOPS=0
# For a remote database, use DATABASE_SSL=true. Certificates are verified.
# Optional DATABASE_CA contains your provider's CA PEM if it uses a private CA.
# Optional maintenance-only limits (milliseconds); normal API timeouts are unchanged.
# MIGRATION_STATEMENT_TIMEOUT_MS=60000
# MIGRATION_LOCK_TIMEOUT_MS=5000

